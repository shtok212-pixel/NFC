# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by API routes to place
# orders/waiter calls with elevated trust (price lookups, atomic inserts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public half of the VAPID keypair used for the "enable notifications"
# re-engagement option (Wi-Fi/review flow). Generate a pair with
# `npx web-push generate-vapid-keys` — the private half is a Supabase Edge
# Function secret (see supabase/functions/send-review-requests/README.md),
# never put it here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
